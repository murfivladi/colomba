{
  "name": "@colomba/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env src/cli/seed.ts",
    "import:geonames": "tsx --env-file-if-exists=.env src/cli/import-geonames.ts",
    "make-admin": "tsx --env-file-if-exists=.env src/cli/make-admin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@colomba/shared": "0.1.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@simplewebauthn/server": "^14.0.3",
    "fastify": "^5.12.7",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.3.1",
    "searoute-ts": "^2.3.1",
    "suncalc": "^2.1.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/suncalc": "^1.9.2",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  }
}
