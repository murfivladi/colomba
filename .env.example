# Скопируйте в .env на VPS. Секреты — только здесь, никогда в репозитории.
PUBLIC_URL=https://vladinc.ru/colomba
API_PREFIX=/api
COOKIE_SECURE=true
COOKIE_PATH=/colomba
WEBAUTHN_RP_ID=vladinc.ru
# Запасной вариант без mod_proxy: поддомен api.vladinc.ru + CORS
CORS_ORIGINS=

DB_NAME=colomba
DB_USER=colomba
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Маршруты по дорогам: https://openrouteservice.org (бесплатный план Standard)
ORS_API_KEY=
# Резерв: https://graphhopper.com (Free, только некоммерческое использование)
GRAPHHOPPER_API_KEY=
WEATHER_ENABLED=true

# Почта для входа по коду/ссылке, например smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Colomba <colomba@vladinc.ru>
DEV_LOG_CODES=false

# Web Push: если пусто — ключи сгенерируются и сохранятся в базе
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:colomba@vladinc.ru

# Кто станет администратором при регистрации (через запятую)
ADMIN_EMAILS=
# Закрытая бета: регистрация только по приглашению
INVITE_ONLY=true
