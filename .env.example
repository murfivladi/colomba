# На VPS этот файл (/opt/colomba/.env) создаёт и обновляет деплой из GitHub Actions.
# Пример — для ручной установки. Секреты — только здесь, никогда в репозитории.
PUBLIC_URL=https://vladinc.ru/colomba
API_PREFIX=/api
COOKIE_SECURE=true
COOKIE_PATH=/
WEBAUTHN_RP_ID=vladinc.ru
# Фронт на vladinc.ru, API на https://colomba-api.vladinc.ru:5576
CORS_ORIGINS=https://vladinc.ru,https://www.vladinc.ru
# HTTPS в самом бэкенде (в docker-compose заданы пути к сертификату из ./certs)
TLS_CERT_FILE=
TLS_KEY_FILE=

DB_NAME=colomba
DB_USER=colomba
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Маршруты по дорогам: https://openrouteservice.org (бесплатный план Standard)
ORS_API_KEY=
# Резерв: https://graphhopper.com (Free, только некоммерческое использование)
GRAPHHOPPER_API_KEY=
WEATHER_ENABLED=true

# Почта для входа по коду/ссылке, например smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Colomba <colomba@vladinc.ru>
DEV_LOG_CODES=false

# Web Push: если пусто — ключи сгенерируются и сохранятся в базе
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:colomba@vladinc.ru

# Кто станет администратором при регистрации (через запятую)
ADMIN_EMAILS=
# Закрытая бета: регистрация только по приглашению
INVITE_ONLY=true
