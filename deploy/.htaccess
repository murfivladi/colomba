# vladinc.ru/colomba/.htaccess — статика PWA на shared-хостинге,
# /colomba/api/* проксируется на VPS (нужен mod_proxy + mod_proxy_http).
# Если хостинг не разрешает mod_proxy — используйте поддомен api.vladinc.ru с CORS (см. README).
RewriteEngine On
RewriteBase /colomba/

# API → VPS. SSE (/api/me/stream) через такой прокси работает надёжнее WebSocket.
RewriteRule ^api/(.*)$ https://VPS_HOST/api/$1 [P,L,QSA]

# Service Worker и манифест не кэшировать надолго
<FilesMatch "^(sw\.js|manifest\.webmanifest|index\.html)$">
  Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(js|css|woff2?|png|svg)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
AddType application/manifest+json .webmanifest

# Хеш-роутинг: всё остальное — index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.html [L]
