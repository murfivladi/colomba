# vladinc.ru/colomba/.htaccess — статика PWA на shared-хостинге.
# API живёт отдельно: https://colomba-api.vladinc.ru:5576 (адрес вшивается при сборке).
RewriteEngine On
RewriteBase /colomba/

# Service Worker, манифест и index.html не кэшировать надолго — иначе обновления не дойдут
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|manifest\.webmanifest|index\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
AddType application/manifest+json .webmanifest

# Хеш-роутинг: всё остальное — index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.html [L]
